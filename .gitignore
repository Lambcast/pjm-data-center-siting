# Python
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.ruff_cache/
*.egg-info/

# Environment
.env
.env.local
.env.*.local

# Node / Vite (frontend)
node_modules/
dist/
.vite/

# DuckDB local files
*.duckdb
*.duckdb.wal

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Jupyter
.ipynb_checkpoints/

# Raw data (keep directory tracked via .gitkeep, ignore everything else)
data/raw/*
!data/raw/.gitkeep

# Reference PDFs (keep README tracked, ignore PDFs for copyright reasons)
docs/references_pdfs/*
!docs/references_pdfs/README.md

# Local PDF copies of cited papers (references/ folder added during framing lock)
references/*.pdf
references/*.docx
!references/.gitkeep
!references/README.md

.claude/